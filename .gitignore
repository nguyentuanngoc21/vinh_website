# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tesseract.js (src/lib/ocr.ts) caches its Vietnamese language data as a
# plain file in the working directory on Node — not source, don't commit it
*.traineddata

# python-service/ (Quest System Phase 2 worker)
python-service/.venv
python-service/**/__pycache__
*.pyc
