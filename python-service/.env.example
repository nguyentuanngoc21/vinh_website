# Copy sang .env (KHÔNG commit .env thật) cho dev local — production set
# qua biến môi trường của platform hosting (Railway/Render/VPS).

# Service role key RIÊNG cho Python — KHÔNG dùng chung anon key với
# Next.js. Cần quyền đọc chapters, đọc/ghi quest_generation_jobs (chưa
# đọc/ghi quest_candidates ở phase skeleton này).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Không bắt buộc để worker CHẠY được (khung poll/process/log vẫn hoạt
# động, xem app/claude_client.py) — nhưng bắt buộc để lời gọi Claude thật
# không bị bỏ qua/log cảnh báo.
ANTHROPIC_API_KEY=

# Giây giữa 2 lượt poll — mặc định 45s theo khuyến nghị "interval 30-60s"
# trong spec.
POLL_INTERVAL_SECONDS=45

# Số lần retry tối đa/job trước khi set status='failed' hẳn.
MAX_ATTEMPTS=3

# Số job xử lý tối đa/lượt poll.
JOB_BATCH_SIZE=5
